# ---------------------------------------------------------------------------
# Variaveis de ambiente da Agenda Inteligente 360
# ---------------------------------------------------------------------------
# COMO USAR (desenvolvimento local):
#   1. Copie este arquivo:   cp .env.example .env.local
#   2. Preencha as duas variaveis abaixo com os dados do seu projeto Supabase
#      (painel do Supabase > Settings > API).
#
# O arquivo .env.local NAO vai para o Git (ja esta no .gitignore).
#
# DETECCAO AUTOMATICA DE MODO:
#   - Com VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY preenchidas -> MODO SUPABASE
#     (login real + dados salvos na nuvem).
#   - Vazias -> MODO DEMO (login faz-de-conta + dados no localStorage do navegador).
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional - integracao futura com IA (deixe 'mock' para usar o assistente
# simulado, sem chamar nenhuma API). Provedores: 'openai' | 'anthropic' | 'mock'
VITE_AI_PROVIDER=mock
VITE_AI_API_KEY=

# Notificacoes Web Push (Sprint 2 / Etapa 1D) - chave PUBLICA do VAPID.
# So a chave publica: a privada fica exclusivamente nos secrets da Edge
# Function push-delivery-worker, nunca aqui. Sem esta variavel, o botao
# "Ativar notificacoes do dispositivo" retorna vapid_not_configured.
VITE_VAPID_PUBLIC_KEY=
