# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase.
# Settings > API no painel do Supabase.
#
# Se estas variaveis NAO forem preenchidas, a aplicacao roda em MODO DEMO,
# guardando os dados no localStorage do navegador (util para testar sem backend).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional - integracao futura com IA (deixe vazio para usar o assistente mockado)
# Provedores suportados: 'openai' | 'anthropic' | 'mock'
VITE_AI_PROVIDER=mock
VITE_AI_API_KEY=
